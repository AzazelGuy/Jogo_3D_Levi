# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
/Jogo 3D LeviGabriel/.utmp/
/Jogo 3D LeviGabriel/[Ll]ibrary/
/Jogo 3D LeviGabriel/[Tt]emp/
/Jogo 3D LeviGabriel/[Oo]bj/
/Jogo 3D LeviGabriel/[Bb]uild/
/Jogo 3D LeviGabriel/[Bb]uilds/
/Jogo 3D LeviGabriel/[Ll]ogs/
/Jogo 3D LeviGabriel/[Uu]ser[Ss]ettings/
/Jogo 3D LeviGabriel/*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
/Jogo 3D LeviGabriel/*.blend1
/Jogo 3D LeviGabriel/*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/Jogo 3D LeviGabriel/[Mm]emoryCaptures/

# Recordings can get excessive in size
/Jogo 3D LeviGabriel/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
Jogo 3D LeviGabriel/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
/Jogo 3D LeviGabriel/*.DotSettings.user

# Visual Studio cache directory
/Jogo 3D LeviGabriel/.vs/
/Jogo 3D LeviGabriel/ .vscode/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
/Jogo 3D LeviGabriel/*.csproj
/Jogo 3D LeviGabriel/*.unityproj
/Jogo 3D LeviGabriel/*.sln
/Jogo 3D LeviGabriel/*.slnx
/Jogo 3D LeviGabriel/*.suo
/Jogo 3D LeviGabriel/*.tmp
/Jogo 3D LeviGabriel/*.user
/Jogo 3D LeviGabriel/*.userprefs
/Jogo 3D LeviGabriel/*.pidb
/Jogo 3D LeviGabriel/*.booproj
/Jogo 3D LeviGabriel/*.svd
/Jogo 3D LeviGabriel/*.pdb
/Jogo 3D LeviGabriel/*.mdb
/Jogo 3D LeviGabriel/*.opendb
/Jogo 3D LeviGabriel/*.VC.db

# Unity3D generated meta files
/Jogo 3D LeviGabriel/*.pidb.meta
/Jogo 3D LeviGabriel/*.pdb.meta
/Jogo 3D LeviGabriel/*.mdb.meta

# Unity3D generated file on crash reports
/Jogo 3D LeviGabriel/sysinfo.txt

# Mono auto generated files
/Jogo 3D LeviGabriel/mono_crash.*

# Builds
/Jogo 3D LeviGabriel/*.apk
/Jogo 3D LeviGabriel/*.aab
/Jogo 3D LeviGabriel/*.unitypackage
/Jogo 3D LeviGabriel/*.unitypackage.meta
/Jogo 3D LeviGabriel/*.app

# Crashlytics generated file
/Jogo 3D LeviGabriel/crashlytics-build.properties

# TestRunner generated files
/Jogo 3D LeviGabriel/InitTestScene*.unity*

# Addressables default ignores, before user customizations
/Jogo 3D LeviGabriel/ServerData
/Jogo 3D LeviGabriel/[Aa]ssets/StreamingAssets/aa*
/Jogo 3D LeviGabriel/[Aa]ssets/AddressableAssetsData/link.xml*
/Jogo 3D LeviGabriel/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/Jogo 3D LeviGabriel/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/Jogo 3D LeviGabriel/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/Jogo 3D LeviGabriel/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/Jogo 3D LeviGabriel/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/Jogo 3D LeviGabriel/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/Jogo 3D LeviGabriel/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Auto-generated cache in Assets folder
/[Aa]ssets/[Ss]ceneDependencyCache*
Jogo 3D LeviGabriel/.vsconfig
